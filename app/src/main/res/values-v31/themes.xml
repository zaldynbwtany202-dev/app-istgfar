<?xml version="1.0" encoding="utf-8"?>
<!-- وسن · شاشة الافتتاح في أندرويد 12+ (SplashScreen API): خلفية زمردية + الهلال الذهبي -->
<resources>
    <style name="Theme.Noor.Splash" parent="Theme.Noor">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowSplashScreenBackground">@color/wasan_splash</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenAnimationDuration">300</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/wasan_splash_bottom</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
